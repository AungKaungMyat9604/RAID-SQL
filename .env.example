# RAID-SQL — copy to .env and fill in credentials (never commit .env)

# --- Recommended locked claim stack (Gemini chat + Gemini embeddings) ---
CHAT_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Option A: API key
# GEMINI_API_KEY=
# Option B: Vertex AI service account
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
FEWSHOT_COLLECTION=spider_train_fewshot_gemini
GEMINI_EMBEDDING_DIMS=768
GEMINI_EMBEDDING_PER_M=0.10

# Spider data root (tables.json, train/dev/test JSON, database/, test_database/)
# Default relative path assumes sibling checkout of DIN-SQL data:
#   ../Few-shot-NL2SQL-with-prompting/data
# Or set an absolute path to your Spider download:
# SPIDER_DATA_DIR=/absolute/path/to/spider/data

# --- Alternatives ---
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# FEWSHOT_COLLECTION=spider_train_fewshot_openai
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# FEWSHOT_COLLECTION=spider_train_fewshot

# --- Locked fair pipeline knobs (do not change for claim reproduction) ---
USE_RAG=true
USE_EXECUTION_REPAIR=true
USE_SELF_CONSISTENCY=true
INCLUDE_DB_VALUES=true
USE_DIN_STATIC_BANKS=false
FEWSHOT_TOP_K=6
SELF_CONSISTENCY_K=5
MAX_REPAIR_ATTEMPTS=3
DEBUG_MAX_OUTPUT_TOKENS=600

OPENAI_INPUT_PER_M=2.50
OPENAI_OUTPUT_PER_M=10.00
OPENAI_EMBEDDING_PER_M=0.02
